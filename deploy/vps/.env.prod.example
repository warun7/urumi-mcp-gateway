# Copy to deploy/vps/.env.prod (gitignored). Everything is optional: unset values are generated by
# create-secrets.sh and live only in the cluster. Read by create-secrets.sh and setup-cluster.sh.

# Let's Encrypt account email (setup-cluster.sh; required there).
ACME_EMAIL=

# Chat agent: key for the OpenAI-compatible API set in charts/platform/values-prod.yaml (agent.llm).
LLM_API_KEY=

# Pin the dashboard admin / WordPress admin passwords instead of generating them.
ADMIN_PASSWORD=
WP_ADMIN_PASSWORD=
